          },
          "enterBehavior": "none",
          "enterAction": {
            "event": {
              "name": "photosEnter"
            }
          },
          "escapeAction": {
            "event": {
              "name": "photosEscape"
            }
          },
          "excludeFromSubmit": false,
          "visible": true
        }
      ]
    }
