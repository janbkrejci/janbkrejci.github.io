          "ulice": "Na Petřinách",
          "cisloDomovni": "276",
          "cisloOrientacni": "10",
          "castObce": "Veleslavín",
          "obec": "Praha",
          "psc": "16200",
          "okres": "Hlavní město Praha"
        },
        "errors": {}
      }
    }
  }
]
